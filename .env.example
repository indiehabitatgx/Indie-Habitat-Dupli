# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/indie_habitat"

# Public canonical origin (no trailing slash) — used for canonical URLs, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL="https://indiehabitat.com"

# 32+ random bytes used to sign admin session tokens:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# First administrator, created by `npm run db:seed` (only if no admin exists). Change the password after first login.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional: Instagram feed (official Instagram API). Prefer connecting in Admin → Settings instead;
# a token saved there takes precedence and is auto-refreshed.
INSTAGRAM_ACCESS_TOKEN=""

# Optional: Habitat Assistant mode. Leave unset for the built-in grounded answer engine (no API cost).
# Set to "claude" to have Claude write replies (grounded in the same knowledge base). Requires Anthropic
# credentials (ANTHROPIC_API_KEY, or an `ant auth login` profile on the server).
ASSISTANT_MODE=""
ANTHROPIC_API_KEY=""

# ── Neon (written by `neon deploy` / `neon env pull`) ──
# Pooled connection for the app (host contains "-pooler"); DATABASE_URL above should hold this value on Neon.
# Direct connection for migrations and seeding:
DATABASE_URL_UNPOOLED=""
# Neon Realtime (live announcement bar). The secret is server-only; the URL is the public WebSocket endpoint.
NEON_REALTIME_URL=""
NEON_REALTIME_SECRET=""
